{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quranrecitationkit.local/events.schema.json",
  "title": "QuranRecitationKit events and sidecar replies",
  "$defs": {
    "verse": {
      "type": "object",
      "required": [
        "surah",
        "ayah",
        "confidence",
        "duration_seconds"
      ],
      "properties": {
        "surah": {
          "type": "integer",
          "minimum": 1,
          "maximum": 114
        },
        "ayah": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Uncalibrated CTC margin mapped as 1-exp(-max(0,margin)); not a recitation-correctness probability."
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "quote_candidate": {
      "type": "object",
      "required": [
        "surah",
        "ayah_from",
        "ayah_to",
        "word_from",
        "word_to",
        "confidence",
        "text_uthmani",
        "reference"
      ],
      "properties": {
        "surah": {
          "type": "integer",
          "minimum": 1,
          "maximum": 114
        },
        "ayah_from": {
          "type": "integer",
          "minimum": 1
        },
        "ayah_to": {
          "type": "integer",
          "minimum": 1
        },
        "word_from": {
          "type": "integer",
          "minimum": 0
        },
        "word_to": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "text_uthmani": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "quote": {
      "type": "object",
      "required": [
        "surah",
        "ayah_from",
        "ayah_to",
        "word_from",
        "word_to",
        "confidence",
        "text_uthmani",
        "reference",
        "start_seconds",
        "end_seconds",
        "verified",
        "ambiguous",
        "candidates"
      ],
      "properties": {
        "surah": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 114
            },
            {
              "type": "null"
            }
          ]
        },
        "ayah_from": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ayah_to": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "word_from": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "word_to": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "text_uthmani": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "minimum": 0
        },
        "verified": {
          "type": "boolean"
        },
        "ambiguous": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/quote_candidate"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ambiguous": {
                "const": true
              }
            },
            "required": [
              "ambiguous"
            ]
          },
          "then": {
            "properties": {
              "verified": {
                "const": false
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "candidates": {
                "minItems": 2
              },
              "surah": {
                "type": "null"
              },
              "ayah_from": {
                "type": "null"
              },
              "ayah_to": {
                "type": "null"
              },
              "word_from": {
                "type": "null"
              },
              "word_to": {
                "type": "null"
              },
              "text_uthmani": {
                "type": "null"
              },
              "reference": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "verified": {
                "const": true
              },
              "surah": {
                "type": "integer",
                "minimum": 1,
                "maximum": 114
              },
              "ayah_from": {
                "type": "integer",
                "minimum": 1
              },
              "ayah_to": {
                "type": "integer",
                "minimum": 1
              },
              "word_from": {
                "type": "integer",
                "minimum": 0
              },
              "word_to": {
                "type": "integer",
                "minimum": 0
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "text_uthmani": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "state"
      ],
      "properties": {
        "type": {
          "const": "state"
        },
        "state": {
          "enum": [
            "idle",
            "listening",
            "evaluating",
            "ended"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "text",
        "confidence"
      ],
      "properties": {
        "type": {
          "const": "raw_transcript"
        },
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Geometric mean of peak posteriors for emitted greedy CTC tokens; zero when none are emitted. Not target-acceptance authority."
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "needs_retry"
        },
        "reason": {
          "enum": [
            "inconclusive",
            "off_target",
            "noise",
            "too_short"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "surah",
        "ayah",
        "word_index",
        "total_words",
        "matched_word_indices",
        "confidence"
      ],
      "properties": {
        "type": {
          "const": "word_progress"
        },
        "surah": {
          "type": "integer",
          "minimum": 1,
          "maximum": 114
        },
        "ayah": {
          "type": "integer",
          "minimum": 1
        },
        "word_index": {
          "type": "integer",
          "minimum": 0
        },
        "total_words": {
          "type": "integer",
          "minimum": 1
        },
        "matched_word_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Uncalibrated CTC margin mapped as 1-exp(-max(0,margin)); not a recitation-correctness probability."
        }
      },
      "additionalProperties": false
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/verse"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "verse_match"
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "type",
        "verses",
        "transcript",
        "duration"
      ],
      "properties": {
        "type": {
          "const": "summary"
        },
        "verses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verse"
          }
        },
        "transcript": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        },
        "dropped_chunks": {
          "type": "integer",
          "minimum": 0
        },
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "surah",
        "ayah_from",
        "ayah_to",
        "word_from",
        "word_to",
        "confidence",
        "text_uthmani",
        "reference",
        "start_seconds",
        "end_seconds",
        "verified",
        "ambiguous",
        "candidates"
      ],
      "properties": {
        "type": {
          "const": "quote_detected"
        },
        "surah": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 114
            },
            {
              "type": "null"
            }
          ]
        },
        "ayah_from": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ayah_to": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "word_from": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "word_to": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "text_uthmani": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "minimum": 0
        },
        "verified": {
          "type": "boolean"
        },
        "ambiguous": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/quote_candidate"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ambiguous": {
                "const": true
              }
            },
            "required": [
              "ambiguous"
            ]
          },
          "then": {
            "properties": {
              "verified": {
                "const": false
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "candidates": {
                "minItems": 2
              },
              "surah": {
                "type": "null"
              },
              "ayah_from": {
                "type": "null"
              },
              "ayah_to": {
                "type": "null"
              },
              "word_from": {
                "type": "null"
              },
              "word_to": {
                "type": "null"
              },
              "text_uthmani": {
                "type": "null"
              },
              "reference": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "verified": {
                "const": true
              },
              "surah": {
                "type": "integer",
                "minimum": 1,
                "maximum": 114
              },
              "ayah_from": {
                "type": "integer",
                "minimum": 1
              },
              "ayah_to": {
                "type": "integer",
                "minimum": 1
              },
              "word_from": {
                "type": "integer",
                "minimum": 0
              },
              "word_to": {
                "type": "integer",
                "minimum": 0
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "text_uthmani": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "type",
        "verified",
        "ambiguous",
        "candidates"
      ],
      "properties": {
        "type": {
          "const": "text_match"
        },
        "verified": {
          "const": false
        },
        "ambiguous": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/quote_candidate"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
